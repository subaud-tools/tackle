{
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "alwaysStrict": false,
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "lib": ["es2022", "dom", "dom.iterable"]
  },
  "include": ["*.ts"],
  "exclude": ["*.test.ts"]
}
